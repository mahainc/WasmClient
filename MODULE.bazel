"""Side-by-side Bazel build for the WasmClient SPM package.

Pinned to the versions rules_swift_package_manager 1.21.0 is validated against
(rules_swift 3.6.x / rules_apple 4.5.x on Bazel 8.7.0). Additive — does NOT
touch the Xcode/SPM build; consuming apps still resolve WasmClient via SPM.
"""

module(
    name = "wasmclient",
    version = "0.0.0",
)

bazel_dep(name = "rules_swift_package_manager", version = "1.21.0")
bazel_dep(name = "cgrindel_bazel_starlib", version = "0.30.0")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "apple_support", version = "2.7.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_swift", version = "3.6.1", repo_name = "build_bazel_rules_swift")
bazel_dep(name = "rules_apple", version = "4.5.3", repo_name = "build_bazel_rules_apple")

bazel_dep(name = "bazel_skylib_gazelle_plugin", version = "1.9.0", dev_dependency = True)
bazel_dep(name = "gazelle", version = "0.51.3", dev_dependency = True, repo_name = "bazel_gazelle")
bazel_dep(name = "swift_gazelle_plugin", version = "0.2.2", dev_dependency = True)

apple_cc_configure = use_extension(
    "@apple_support//crosstool:setup.bzl",
    "apple_cc_configure_extension",
)
use_repo(apple_cc_configure, "local_config_apple_cc")

swift_deps = use_extension(
    "@rules_swift_package_manager//:extensions.bzl",
    "swift_deps",
)
swift_deps.from_package(
    declare_swift_deps_info = True,
    resolved = "//:Package.resolved",
    swift = "//:Package.swift",
)

# flow-kit's asyncify_wasmFFI/module.modulemap uses Clang `use "..."` directives
# that rspm's modulemap parser rejects. They are advisory — strip them for the
# Bazel build only (does not touch the real flow-kit repo / Xcode/SPM build).
swift_deps.configure_package(
    name = "flow-kit",
    patch_args = ["-p1"],
    patches = ["//third-party/flow-kit:module.modulemap.patch"],
)

# use_repo entries below are auto-managed by `bazel run //:update_build_files`
# (gazelle). Seeded with the index repos; the swiftpkg_* list gets appended.
use_repo(
    swift_deps,
    "swift_deps_info",
    "swift_package",
    "swiftpkg_flow_kit",
    "swiftpkg_swift_dependencies",
    "swiftpkg_swift_protobuf",
)
