load("@bazel_gazelle//:def.bzl", "gazelle", "gazelle_binary")
load("@rules_swift_package_manager//swiftpkg:defs.bzl", "swift_package_tool")

# Regenerate Package.resolved from Package.swift (only when deps change).
#   bazel run //:update_swift_packages
swift_package_tool(
    name = "update_swift_packages",
    cmd = "update",
    package = "Package.swift",
)

# gazelle:exclude .build
# gazelle:exclude .bazel

# FlowKit's binary swiftmodule + WasmClient's generated `*.pb.swift` both
# `import WasmSwiftProtobuf` — SwiftProtobuf aliased to that module name. Map the
# aliased import to the SwiftProtobuf label so gazelle can complete generation.
# gazelle:resolve swift WasmSwiftProtobuf @swiftpkg_swift_protobuf//:SwiftProtobuf

gazelle_binary(
    name = "gazelle_bin",
    languages = [
        "@swift_gazelle_plugin//gazelle",
    ],
)

# Generate/refresh BUILD.bazel for the first-party targets + the MODULE.bazel
# use_repo list.  bazel run //:update_build_files
gazelle(
    name = "update_build_files",
    data = [
        "@swift_deps_info//:swift_deps_index",
    ],
    extra_args = [
        "-swift_dependency_index=$(location @swift_deps_info//:swift_deps_index)",
    ],
    gazelle = ":gazelle_bin",
)

exports_files([
    "Package.swift",
    "Package.resolved",
])

# Explicit iOS-Simulator platform (Apple Silicon) so bare libraries can be
# compile-verified for iOS without a full ios_application wrapper.
#   bazel build <target> --platforms=//:ios_sim_arm64
platform(
    name = "ios_sim_arm64",
    constraint_values = [
        "@platforms//os:ios",
        "@platforms//cpu:arm64",
        "@apple_support//constraints:simulator",
    ],
)
