      "id": 1,
      "name": "news",
      "title": "News domain (feed, multi-vertical)",
      "status": "done",
      "weight": "light",
      "service_methods": [
        "asyncify.news.NewsService/List"
      ],
      "proto_types": ["NewsNewsItem", "NewsNewsRequest", "NewsNewsResponse"],
      "notes": "Single List RPC, method-name dispatch. Categories: soccer, health, plantCare. Sort: recent, trending. Request supports category/limit/offset/q/tags/sort/params. App surface: NewsView.swift.",
      "example_protos": ["Example/Protos/news.pb.swift", "Example/Protos/news.fk.pb.swift"]
    },
